# Engine error messages. Key: error-<code>; the codes mirror gridcraft_engine::EngineError.
# Original wording for GridCraft in Georgian (ქართული), translated from the en-US reference; not taken from third-party documentation.

error-unknown-command = უცნობი ბრძანება „{ $command }“.
error-command-disabled = „{ $command }“ ახლა მიუწვდომელია: { $reason }
error-bad-params = „{ $command }“-ის პარამეტრები არასწორია: { $message }
error-no-document = სამუშაო წიგნი არ არის გახსნილი.
error-internal = შიდა შეცდომა ბრძანებაში „{ $command }“ (სამუშაო წიგნი უცვლელი დარჩა): { $message }
error-other = { $message }
error-invalid-formula = ფორმულაში პრობლემაა: { $message }
error-invalid-locale = ენის ან რეგიონული პარამეტრები არასწორია: { $message }
error-protected-sheet = ეს ცვლილება დაუშვებელია: უჯრა ან დიაგრამა დაცულ ფურცელზეა.
error-encrypted-workbook = „{ $name }“ პაროლით არის დაცული. მოხსენით პაროლი Excel-ში და სცადეთ ხელახლა; GridCraft დაშიფრულ წიგნებს ჯერ ვერ ხსნის.
error-legacy-workbook = „{ $name }“ არის Excel 97–2003 (.xls) ან სხვა ძველი ბინარული ფაილი. შეინახეთ .xlsx-ად Excel-ში და სცადეთ ხელახლა.
error-import-failed = „{ $name }“ ვერ შემოიტანება: { $message }
error-import-only-format = { $format } მხოლოდ მონაცემების შემოტანას უჭერს მხარს. შეინახეთ .xlsx-ად ან სხვა მხარდაჭერილ ფორმატში.
error-text-box-too-long = ტექსტურ ბლოკში მაქსიმუმ { $limit } სიმბოლო ეტევა.
error-chart-range-too-large = წყარო დიაპაზონი დიაგრამისთვის ძალიან დიდია.
